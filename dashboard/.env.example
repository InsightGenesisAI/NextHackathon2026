# URL of the Python APE hub used during local dev (proxied via /hub/*).
PYTHON_HUB_URL=http://127.0.0.1:8787

# Optional: point the browser directly at a deployed backend instead of the
# Next.js /hub proxy. Leave unset to use the proxy (recommended for local dev).
# NEXT_PUBLIC_API_BASE=https://your-backend.example.com
